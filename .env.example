# ── Sonic Vault web · environment template ────────────────────────────────
# Copy to `.env.local` for development and add the same keys in Vercel.
# NOTE: there are intentionally NO NEXT_PUBLIC_* Supabase vars — the browser
# never talks to Postgres. All DB access is server-side via the service key.

# Supabase project URL.
#   Local dev : http://127.0.0.1:54321   (run `supabase status` to confirm)
#   Production: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Service-role secret key. BYPASSES ROW LEVEL SECURITY — server-only.
#   Local dev : printed by `supabase status`
#   Production: Project Settings → API → service_role (mark as Sensitive in Vercel)
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin (placeholder auth stage; swap for real auth later).
ADMIN_PASSWORD=change-me

# Optional overrides for the /api/download redirect targets.
DOWNLOAD_URL_ANDROID=
DOWNLOAD_URL_IOS=
